{
  "manifest_version": 3,
  "name": "PhishGuard-AI Cyber Threat Shield",
  "version": "1.0.0",
  "description": "AI-Powered Real-Time Phishing URL & Scam Detection directly in your browser.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard-AI Shield",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
